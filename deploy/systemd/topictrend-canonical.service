[Unit]
Description=TopicTrends canonical relation + coverage matrix snapshot (all wikis)
After=network.target

[Service]
Type=oneshot
# Adjust User and WorkingDirectory to match the VPS checkout (must have replica
# access via the user's ~/.my.cnf, same as the daily `make run`).
User=topictrend
WorkingDirectory=/srv/topictrend
# DATE defaults to "yesterday"; for a 1st-of-month firing that labels the
# snapshot with the last day of the previous month. Override DATE= to pin it.
# coverage consumes the canonical projections, so the two run chained: if the
# canonical manifest gate aborts, coverage never runs against truncated inputs.
ExecStart=/usr/bin/make canonical coverage
Nice=10
IOSchedulingClass=idle
