[Unit]
Description=Monthly TopicTrends canonical relation snapshot

[Timer]
# First of each month at 03:00 UTC — after the coverage snapshot (02:00) so the
# two monthly topology-derived artifacts don't contend for the same inputs.
OnCalendar=*-*-01 03:00:00
# Catch up a missed run if the VPS was down at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
